[TEMPLATE]
# Profil Spring (dev par défaut)
SPRING_PROFILES_ACTIVE=dev

# Serveur HTTP
SERVER_PORT=8080
SPRING_APPLICATION_NAME=backend

# Base de données PostgreSQL (docker compose up dans backend/)
POSTGRES_PASSWORD=kfokam48

# Source de données utilisée par l'application (port hôte 5433 = conteneur compose)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/kfokam48
SPRING_DATASOURCE_USERNAME=kfokam48
SPRING_DATASOURCE_PASSWORD=kfokam48

# JPA / Flyway
SPRING_JPA_OPEN_IN_VIEW=false
SPRING_FLYWAY_ENABLED=true
